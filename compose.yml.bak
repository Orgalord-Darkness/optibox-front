name: optibox-frontend

services:
  angular-app:
    build: .
    container_name: angular-app
    ports:
      - "${ANGULAR_PORT}:4200"
    volumes:
      - /var/www/OPtiBox_Heddy/Optibox-Front/certs:/certs:ro
    networks:
      - optibox-shared-network

networks:
  optibox-shared-network:
    external: true
